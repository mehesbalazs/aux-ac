# Saját beállítások: e-mail cím, MAC, SSH-hoszt. SOHA ne kerüljön repóba.
# A minta (config.example.sh) nem illeszkedik erre a mintára, az marad.
config.sh
config.sh.*

# Python környezet és fordítási maradék.
# A .pyc fájlok a forrás konstansait is tartalmazzák, ezért nem elég a forrást
# megtisztítani.
.venv/
__pycache__/
*.py[cod]

# Futási napló: a készülék nevét, állapotát és háztartási időbélyeg-mintát
# tartalmaz. A forgatott példányok is.
klima.log
klima.log.*

# Szerkesztők ideiglenes fájljai — a config.sh másolatát is tartalmazhatják.
.*.sw?
*~

# Aláírt Parancsok-fájlok. A binárisban benne van a hoszt, a felhasználónév és
# a teljes útvonal — és ami veszélyesebb: egy az APPBÓL exportált példány az
# SSH PRIVÁT KULCSOT is magával viszi. Kívülről nem lehet megkülönböztetni a
# generálttól. A parancs_keszito.py bármikor újragenerálja őket.
parancsok/

# macOS
.DS_Store

# Szerkesztői és összefésülési maradékok, helyi környezet.
*.bak
*.orig
*.rej
.env
.idea/
.vscode/
